# Plantilla de variables de entorno — copiar a `.env.local` y rellenar.
# `.env.local` está ignorado por git; este archivo SÍ se versiona.

SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_DB_PASSWORD=

# ──────────────────────────────────────────────────────────────
# Anthropic — asistente de prompts, tester de agentes y chatbot (server-only)
# ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# ──────────────────────────────────────────────────────────────
# GoHighLevel (reemplazo de n8n) — Private Integration Token
# ──────────────────────────────────────────────────────────────
GHL_PRIVATE_INTEGRATION=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=M649NrxtUHpNCNxTC5U1
GHL_CALENDAR_ID=viqiwKhTn4fwtPmOGjfz

# OpenAI — solo para transcripción de audios (Whisper) en el chatbot
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Flujo 1 (webhook Orbe): secreto compartido opcional para autenticar el POST
ORBE_WEBHOOK_SECRET=

# Chatbot: delay (ms) antes de enviar la respuesta a GHL (debounce, default 30s)
CHATBOT_SEND_DELAY_MS=30000

# Flujo 2 (cron de etiquetas en Vercel): secreto que Vercel envía como Bearer
CRON_SECRET=

# Flujo 4 (alerta de errores por email vía Resend) — opcional
RESEND_API_KEY=
ERROR_ALERT_TO=ale@bralto.io
ERROR_ALERT_FROM=errors@send.bralto.io
