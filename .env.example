# Plantilla de variables de entorno — copiar a `.env.local` y rellenar.
# `.env.local` está ignorado por git; este archivo SÍ se versiona.

SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_DB_PASSWORD=

# ──────────────────────────────────────────────────────────────
# Anthropic — asistente de prompts, tester de agentes y chatbot (server-only)
# ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# Ciclo de retroalimentación: modelos separados del chatbot
ANTHROPIC_REVIEW_MODEL=claude-sonnet-5
ANTHROPIC_RULES_MODEL=claude-opus-5

# Ciclo de retroalimentación: horas de silencio que cierran un episodio
REVIEW_IDLE_HOURS=6
# Ciclo de retroalimentación: episodios resumidos por corrida del barrido
REVIEW_BATCH_SIZE=20

# ──────────────────────────────────────────────────────────────
# GoHighLevel (reemplazo de n8n) — Private Integration Token
# ──────────────────────────────────────────────────────────────
GHL_PRIVATE_INTEGRATION=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=M649NrxtUHpNCNxTC5U1
GHL_CALENDAR_ID=viqiwKhTn4fwtPmOGjfz

# ──────────────────────────────────────────────────────────────
# Transcripción de audios (notas de voz de WhatsApp)
# ──────────────────────────────────────────────────────────────
# Anthropic NO transcribe voz (Claude lee texto, imágenes y PDFs), así que
# hace falta un proveedor aparte. Se habla el formato /audio/transcriptions
# de OpenAI, que también implementan Groq y otros: cambiar de proveedor es
# solo cambiar estas tres variables.
#
# OpenAI (default):  TRANSCRIBE_API_KEY=sk-...
# Groq (más barato y rápido):
#   TRANSCRIBE_API_KEY=gsk_...
#   TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
#   TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=

# Compatibilidad: si ya existe OPENAI_API_KEY se sigue usando.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Flujo 1 (webhook Orbe): secreto compartido opcional para autenticar el POST
ORBE_WEBHOOK_SECRET=

# Chatbot: delay (ms) ANTES de leer la conversación. Agrupa los mensajes que el
# huésped manda seguidos y le da tiempo a GHL a indexar. Default 30s, pero se
# recorta solo para no agotar el presupuesto de 60s de la función.
CHATBOT_READ_DELAY_MS=30000

# Chatbot: presupuesto total (ms) del procesamiento en background. Debe quedar
# por debajo de maxDuration (60s) con margen.
CHATBOT_TIME_BUDGET_MS=50000

# Chatbot: workflow de GHL que avisa al equipo cuando el bot escala una
# conversación o transfiere a ventas.
GHL_ESCALATION_WORKFLOW_ID=ba255d47-c90c-425e-8ea7-6b5d9a6211f0

# Chatbot: secreto compartido opcional para autenticar el POST de GHL.
# Si se define, GHL debe mandarlo en el header `x-chatbot-secret` o como
# `?secret=` en la URL del webhook.
CHATBOT_WEBHOOK_SECRET=

# Flujo 2 (cron de etiquetas en Vercel): secreto que Vercel envía como Bearer
CRON_SECRET=

# Flujo 4 (alerta de errores por email vía Resend) — opcional
RESEND_API_KEY=
ERROR_ALERT_TO=ale@bralto.io
ERROR_ALERT_FROM=errors@send.bralto.io

# Escalamiento: contactos de GHL que reciben el aviso por SMS cuando el bot
# escala. IDs separados por coma. El aviso lo manda nuestro código porque el
# nodo "Internal notification" de GHL se ejecuta pero no entrega el WhatsApp.
ESCALATION_NOTIFY_CONTACT_IDS=
