    {
      "parameters": {
        "jsCode": "// ════════════════════════════════════════\n// PARSEO Y NORMALIZACIÓN DEL PAYLOAD ORBE\n// ════════════════════════════════════════\nconst input = $input.first().json;\nconst body = input.body || input;\nconst data = body.data || {};\nconst reservation = (data.hotelReservations || [])[0] || {};\nconst roomStay = ((reservation.roomStays || {}).roomStay || [])[0] || {};\nconst guest = (((reservation.resGuests || {}).resGuest || [])[0] || {}).profiles?.profileInfo?.[0]?.profile?.customer || {};\n\n// IDs de reserva\nconst uniqueIds = reservation.uniqueId || [];\nconst idPrincipal = uniqueIds[0]?.id || '';\nconst idSecundario = uniqueIds[1]?.id || '';\n\n// Conteos de huéspedes (buscar por código en vez de asumir índice)\nconst guestCounts = roomStay.guestCounts?.guestCount || [];\nconst adultos = guestCounts.find(g => String(g.ageQualifyingCode) === '10')?.count || 0;\nconst ninos = guestCounts.find(g => String(g.ageQualifyingCode) === '8')?.count || 0;\n\n// Habitación y tarifas\nconst roomType = roomStay.roomTypes?.roomType?.[0] || {};\nconst total = roomStay.total || {};\nconst baseRate = roomStay.roomRates?.roomRate?.[0]?.rates?.rate?.[0]?.base || {};\n\n// Origen y canal\nconst posSource = data.pos?.source?.[0] || {};\nconst resPosSource = reservation.pos?.source?.[0] || {};\n\n// Fechas: SIEMPRE en timezone Costa Rica (-06:00)\nconst checkInDate = roomStay.timeSpan?.start || '';\nconst checkOutDate = roomStay.timeSpan?.end || '';\n\n// IMPORTANTE: check-in 15:00, check-out 11:00 (no 15:00 como estaba antes)\nconst checkIn = checkInDate ? `${checkInDate}T15:00:00-06:00` : null;\nconst checkOut = checkOutDate ? `${checkOutDate}T11:00:00-06:00` : null;\n\n// fecha_creacion ahora viene del campo correcto del payload\nconst fechaCreacion = reservation.createDateTime || body.timeStamp || new Date().toISOString();\n\nreturn [{\n  json: {\n    id_evento: body.eventId || '',\n    timestamp_webhook: body.timeStamp || new Date().toISOString(),\n    nombre: guest.personName?.givenName || '',\n    apellido: guest.personName?.surname || '',\n    telefono: guest.telephone?.[0]?.phoneNumber || '',\n    email: guest.email?.[0]?.emailAddress || '',\n    id_reserva_principal: idPrincipal,\n    id_reserva_secundario: idSecundario,\n    estado: reservation.resStatus || '',\n    check_in: checkIn,\n    check_out: checkOut,\n    fecha_creacion_reserva: fechaCreacion,\n    adultos: Number(adultos),\n    ninos: Number(ninos),\n    tipo_habitacion: roomType.roomTypeCode || '',\n    cantidad_habitaciones: Number(roomType.numberOfUnits || 1),\n    monto_total: Number(total.amountAfterTax || 0),\n    moneda: total.currencyCode || 'USD',\n    monto_tarifa_base: Number(baseRate.amountAfterTax || 0),\n    nombre_hotel: posSource.property || '',\n    id_hotel: posSource.propertySourceId || '',\n    tipo_canal_venta: String(resPosSource.bookingChannel?.type || ''),\n    agente_origen: posSource.agentSine || ''\n  }\n}];"
      },
