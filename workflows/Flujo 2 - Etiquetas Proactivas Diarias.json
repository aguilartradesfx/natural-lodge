{
  "name": "Flujo 2 - Etiquetas Proactivas Diarias",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "b17d5f0f-bd1d-4083-b593-ae91ab9e1502",
      "name": "Schedule 9AM CR",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -976,
        304
      ],
      "notes": "IMPORTANTE: el timezone del workflow debe estar configurado en 'America/Costa_Rica' (Settings → Workflow → Timezone)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Calcular etiqueta correcta para cada reserva activa\n-- Usa timezone Costa Rica para evitar el bug de UTC\nWITH today_cr AS (\n  SELECT (NOW() AT TIME ZONE 'America/Costa_Rica')::DATE AS hoy\n)\nSELECT \n    r.id_reserva_principal,\n    r.email,\n    r.telefono,\n    r.nombre,\n    r.apellido,\n    r.check_in,\n    r.check_out,\n    r.etiqueta_actual,\n    CASE \n        WHEN r.check_in::DATE = (SELECT hoy FROM today_cr) + INTERVAL '3 days' THEN '⏳ check-in: 3 días'\n        WHEN r.check_in::DATE = (SELECT hoy FROM today_cr) + INTERVAL '1 day' THEN '🔔 check-in: mañana'\n        WHEN r.check_in::DATE = (SELECT hoy FROM today_cr) THEN '✅ check-in: hoy'\n        WHEN r.check_out::DATE = (SELECT hoy FROM today_cr) - INTERVAL '1 day' THEN '⭐ check-out: realizado'\n    END AS etiqueta_nueva\nFROM reservas_orbe r, today_cr\nWHERE r.estado = 'Commit'\n  AND (\n    r.check_in::DATE = today_cr.hoy + INTERVAL '3 days' OR\n    r.check_in::DATE = today_cr.hoy + INTERVAL '1 day' OR\n    r.check_in::DATE = today_cr.hoy OR\n    r.check_out::DATE = today_cr.hoy - INTERVAL '1 day'\n  );",
        "options": {}
      },
      "id": "94662595-56d9-46dc-b20e-f6cb93d8ef89",
      "name": "Query Reservas Día",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -768,
        304
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "pGtF6jU4wFmQ5Uh3",
          "name": "Postgres account"
        }
      }
    },
